# Optional. Copy to .env, or configure the same fields in the app Settings.
# Existing shell environment takes priority over .env and local Settings.
KIDOBS_AI_PROVIDER=openai-compatible
KIDOBS_AI_BASE=https://api.openai.com/v1
KIDOBS_AI_MODEL=
KIDOBS_AI_KEY=
KIDOBS_AI_THINKING=off
# Keep empty to use the separate kidobs-community app data folder.
KIDOBS_DATA_DIR=
# Optional Tencent Cloud face recognition. Prefer the app Settings for first use.
# Leave these empty to keep Settings editable; 1 enables, 0 disables explicitly.
KIDOBS_FACE_ENABLED=
KIDOBS_TC_ID=
KIDOBS_TC_KEY=
KIDOBS_TC_REGION=
